[Unit]
Description=Incremental NGINX incoming traffic collector
After=network-online.target

[Service]
Type=simple
# Match the Django application's account, environment and working directory.
User=nginxproxy
Group=nginxproxy
SupplementaryGroups=nginx
WorkingDirectory=/opt/proxy-admin
EnvironmentFile=-/etc/proxy-admin.env
ExecStart=/opt/proxy-admin/.venv/bin/python manage.py collect_traffic
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
